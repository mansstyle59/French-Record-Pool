rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /_connection_test_/{docId} {
      allow read: if true;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && 
             request.auth.token.email.lower() == 'dewulf.denis@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.keys().size() >= 2 &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256;
    }

    function isValidTrack(data) {
      return data.keys().hasAll(['title', 'artist', 'fileUrl', 'previewUrl']) &&
             data.title is string && data.title.size() <= 256 &&
             data.artist is string && data.artist.size() <= 256 &&
             data.fileUrl is string && data.fileUrl.size() <= 2048 &&
             data.previewUrl is string && data.previewUrl.size() <= 2048 &&
             (!('bpm' in data) || data.bpm is number) &&
             (!('key' in data) || data.key is string);
    }

    // User Rules
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if (isSignedIn() && request.auth.uid == userId && 
                    (incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'favoriteTracks']) ||
                     (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'favoriteTracks', 'subscriptionStatus']))))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // Track Rules
    match /tracks/{trackId} {
      allow read: if true;
      allow create: if isAdmin() && isValidTrack(incoming());
      allow update: if (isAdmin() && isValidTrack(incoming())) ||
                    (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['downloadCount']) && (incoming().downloadCount == existing().downloadCount + 1 || incoming().downloadCount == 1));
      allow delete: if isAdmin();
    }

    // Settings Rules
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
